#!/bin/bash

# Uninstall all NB scripts

if [ -z "${NB_DIR:-}" ]; then
    echo "NB_DIR is not set, aborting" >&2
    exit 1
fi

rm -rf -- "$NB_DIR"
sed -i '\|^source ~/\.nb/nb\.sh$|d' ~/.bashrc
unset NB_DIR
unset NB_PROFILE
unset NB_VERSION

echo "NB scripts have been uninstalled"
echo "WARNING: created systemd units and unprivileged users created by NB scripts have not been changed. You may encounter issues if using nb_autoscale"
